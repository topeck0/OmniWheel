    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.0-alpha</Version>
    <AssemblyName>OmniWheelPC</AssemblyName>
    <RootNamespace>OmniWheelPC</RootNamespace>
